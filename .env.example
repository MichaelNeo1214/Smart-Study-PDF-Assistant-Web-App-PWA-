# Firebase web app config (Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check: reCAPTCHA v3 SITE key for the live domain (public key).
# The secret key stays in the Firebase console, never in this file.
VITE_RECAPTCHA_SITE_KEY=

# Development only. Leave empty to auto-generate a debug token in dev mode.
# If you need a fixed token (CI or another browser), paste it here and
# register it in Firebase Console -> App Check -> Apps -> Manage debug tokens.
# NEVER put a real debug token in a public repository.
VITE_APP_CHECK_DEBUG_TOKEN=
